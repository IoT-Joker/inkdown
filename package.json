{
  "name": "inkdown",
  "version": "0.1.0",
  "description": "Inkdown - a Typora-like WYSIWYG markdown editor built on marktext's muya engine",
  "main": "./out/main/index.js",
  "author": "inkdown",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/start.js",
    "launch": "node scripts/start.js",
    "smoke": "node scripts/smoke-test.js",
    "filetest": "node scripts/file-test.js",
    "sessiontest": "node scripts/session-test.js",
    "shots": "node scripts/capture-shots.js",
    "shot:find": "node scripts/capture-find-shot.js",
    "verify": "electron-vite build && node scripts/smoke-test.js && node scripts/file-test.js && node scripts/session-test.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:muya": "tsc --noEmit -p tsconfig.muya.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run typecheck && npm run verify",
    "icons": "node scripts/make-icons.js",
    "package": "node scripts/package.js",
    "package:dir": "node scripts/package.js --dir"
  },
  "build": {
    "appId": "com.iotjoker.inkdown",
    "productName": "Inkdown",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@muyajs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/prismjs": "^1.26.6",
    "@types/turndown": "^5.0.6",
    "@types/underscore": "^1.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
