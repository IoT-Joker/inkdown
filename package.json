{
  "name": "inkdown",
  "version": "1.2.1",
  "description": "Inkdown - a focused WYSIWYG markdown editor for the desktop",
  "main": "./out/main/index.js",
  "author": "inkdown",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/start.js",
    "launch": "node scripts/start.js",
    "smoke": "node scripts/stability-test.js --smoke",
    "filetest": "node scripts/workflow-test.js files",
    "sessiontest": "node scripts/workflow-test.js session",
    "recoverytest": "node scripts/workflow-test.js recovery",
    "regression": "node --test scripts/regression-test.js",
    "exporttest": "node scripts/export-test.js",
    "shots": "node scripts/capture-shots.js",
    "shot:find": "node scripts/capture-find-shot.js",
    "verify": "electron-vite build && node --test scripts/regression-test.js && node scripts/export-test.js && node scripts/stability-test.js --smoke && node scripts/workflow-test.js files && node scripts/workflow-test.js session && node scripts/workflow-test.js recovery",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:muya": "tsc --noEmit -p tsconfig.muya.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:muya",
    "check": "pnpm run typecheck && pnpm run verify",
    "verify:package": "node scripts/verify-package.js && node scripts/verify-packaged.js",
    "perf": "node scripts/perf-bench.js && node scripts/perf-in-app.js",
    "icons": "node scripts/make-icons.js",
    "version:bump": "node scripts/version.js",
    "package": "node scripts/package.js",
    "package:dir": "node scripts/package.js --dir",
    "release": "node scripts/package.js && node scripts/publish-release.js"
  },
  "build": {
    "appId": "com.iotjoker.inkdown",
    "productName": "Inkdown",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "!node_modules/mermaid/**/*",
      "!node_modules/@mermaid-js/**/*",
      "!node_modules/cytoscape/**/*",
      "!node_modules/cytoscape-*/**/*",
      "!node_modules/elkjs/**/*",
      "!node_modules/dagre-d3-es/**/*",
      "!node_modules/roughjs/**/*",
      "!node_modules/@upsetjs/**/*",
      "!node_modules/flowchart.js/**/*",
      "!node_modules/khroma/**/*",
      "!node_modules/layout-base/**/*",
      "!node_modules/cose-base/**/*",
      "!node_modules/stylis/**/*",
      "!node_modules/topojson-client/**/*",
      "!node_modules/delaunator/**/*",
      "!node_modules/robust-predicates/**/*",
      "!node_modules/points-on-curve/**/*",
      "!node_modules/points-on-path/**/*",
      "!node_modules/path-data-parser/**/*",
      "!node_modules/hachure-fill/**/*",
      "!node_modules/eve/**/*",
      "!node_modules/eve-raphael/**/*",
      "!node_modules/webfontloader/**/*",
      "!node_modules/snapsvg/**/*",
      "!node_modules/snapsvg-cjs/**/*",
      "!node_modules/raphael/**/*",
      "!node_modules/d3/**/*",
      "!node_modules/d3-array/**/*",
      "!node_modules/d3-axis/**/*",
      "!node_modules/d3-brush/**/*",
      "!node_modules/d3-chord/**/*",
      "!node_modules/d3-color/**/*",
      "!node_modules/d3-contour/**/*",
      "!node_modules/d3-delaunay/**/*",
      "!node_modules/d3-dispatch/**/*",
      "!node_modules/d3-drag/**/*",
      "!node_modules/d3-dsv/**/*",
      "!node_modules/d3-ease/**/*",
      "!node_modules/d3-fetch/**/*",
      "!node_modules/d3-force/**/*",
      "!node_modules/d3-format/**/*",
      "!node_modules/d3-geo/**/*",
      "!node_modules/d3-geo-projection/**/*",
      "!node_modules/d3-hierarchy/**/*",
      "!node_modules/d3-interpolate/**/*",
      "!node_modules/d3-path/**/*",
      "!node_modules/d3-polygon/**/*",
      "!node_modules/d3-quadtree/**/*",
      "!node_modules/d3-random/**/*",
      "!node_modules/d3-sankey/**/*",
      "!node_modules/d3-scale/**/*",
      "!node_modules/d3-scale-chromatic/**/*",
      "!node_modules/d3-selection/**/*",
      "!node_modules/d3-shape/**/*",
      "!node_modules/d3-time/**/*",
      "!node_modules/d3-time-format/**/*",
      "!node_modules/d3-timer/**/*",
      "!node_modules/d3-transition/**/*",
      "!node_modules/d3-zoom/**/*",
      "!node_modules/vega/**/*",
      "!node_modules/vega-lite/**/*",
      "!node_modules/@vega/**/*",
      "!node_modules/katex/**/*",
      "!node_modules/prismjs/**/*",
      "!node_modules/rxjs/**/*",
      "!node_modules/es-toolkit/**/*",
      "!node_modules/dompurify/**/*",
      "!node_modules/turndown/**/*",
      "!node_modules/joplin-turndown-plugin-gfm/**/*",
      "!node_modules/@mixmark-io/**/*",
      "!node_modules/file-icons/**/*",
      "!node_modules/marked/**/*",
      "!node_modules/marked-highlight/**/*",
      "!node_modules/plantuml-encoder/**/*",
      "!node_modules/@iconify/**/*",
      "!node_modules/@floating-ui/**/*",
      "!node_modules/snabbdom/**/*",
      "!node_modules/snabbdom-to-html/**/*",
      "!node_modules/github-markdown-css/**/*",
      "!node_modules/fuse.js/**/*",
      "!node_modules/ot-json1/**/*",
      "!node_modules/ot-text-unicode/**/*",
      "!node_modules/unicount/**/*",
      "!node_modules/underscore/**/*",
      "!node_modules/dayjs/**/*",
      "!node_modules/fast-diff/**/*",
      "!node_modules/fast-json-patch/**/*",
      "!node_modules/browser-split/**/*",
      "!node_modules/parse-sel/**/*",
      "!node_modules/html-tags/**/*",
      "!node_modules/atom-fs/**/*",
      "!node_modules/mapped-disposable/**/*",
      "!node_modules/chevrotain/**/*",
      "!node_modules/@chevrotain/**/*",
      "!node_modules/@muyajs/**/*",
      "!node_modules/@marktext/**/*"
    ],
    "extraMetadata": {
      "main": "./out/main/index.js"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdx"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "description": "纯文本文档",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inkdown",
      "artifactName": "Inkdown-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IoT-Joker",
        "repo": "inkdown"
      }
    ]
  },
  "dependencies": {
    "@muyajs/core": "workspace:*",
    "docx": "^9.13.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/prismjs": "^1.26.6",
    "@types/turndown": "^5.0.6",
    "@types/underscore": "^1.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
